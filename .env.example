NODE_ENV=production
PORT=3000

# Database - Apontar para banco externo
DB_HOST=seu-postgres-host.com
DB_PORT=5432
DB_USER=seu-usuario-db
DB_PASSWORD=sua-senha-super-secreta
DB_NAME=auth_db

# JWT Keys - Obrigatório preencher com suas chaves
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...paste converted key here...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...paste converted key here...\n-----END PUBLIC KEY-----"

JWT_ACCESS_TOKEN_MINS_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_DAYS_EXPIRES_IN=7d

# Google OAuth - Opcional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://seu-dominio.com/auth/google/callback
CLIENT_REDIRECT_URL=https://seu-dominio.com/

# E-mail (reset de senha). Com EMAIL_USER + EMAIL_PASS preenchidos, envia via
# Gmail (nodemailer); sem eles, só loga o código (dev). No Gmail, EMAIL_PASS
# precisa ser uma "App Password" (conta com 2FA), não a senha normal.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Beleze
