{
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 4,
  
  "overrides": [
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": [".github/workflows/*.yml", ".github/workflows/*.yaml"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}